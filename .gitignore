node_modules/
dist/
release/
.art-preview/

# Signing credentials — never commit these.
android/keystore.properties
android/*.jks
android/*.keystore

# Capacitor / Gradle build output
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/capacitor-cordova-android-plugins/

.DS_Store
*.log

# Secrets. Never commit these.
.env
.env.*
!.env.example

# Built app. Produced by the build, not source.
*.apk

# ...except the copy the web portal serves.
!public/downloads/*.apk

# Firebase service account keys. These are private keys that never expire and
# grant server-side access to the whole Firebase project — they belong in a
# secret store, never in a repository.
*firebase-adminsdk*.json
serviceAccountKey*.json
