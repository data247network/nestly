# Copy to `keystore.properties` (same folder) and fill in.
# That file is gitignored - it holds real credentials, never commit it.
#
# Create the keystore first (see docs/DISTRIBUTION.md):
#
#   keytool -genkeypair -v -keystore nestly-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias nestly
#
# Keep the .jks file safe and backed up. Losing it means you can never ship an
# update to anyone who already installed a build signed with it.
#
# storeFile is resolved relative to the `android/` folder.

storeFile=nestly-release.jks
storePassword=CHANGE_ME
keyAlias=nestly
keyPassword=CHANGE_ME
