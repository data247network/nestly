{
  "name": "nestly",
  "version": "1.0.0",
  "description": "Nestly - family safety, location and screen-time care (Android + Web)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "cap:build": "vite build --mode native",
    "android:add": "cap add android",
    "android:sync": "npm run cap:build && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:icons": "node scripts/android-icons.mjs",
    "art": "node scripts/render-art.mjs",
    "build:collateral": "node scripts/render-art.mjs && node scripts/build-collateral.mjs && node scripts/build-pdf.mjs && node scripts/verify-pdf.mjs",
    "collateral:measure": "node scripts/measure-pages.mjs",
    "collateral:preview": "node scripts/preview-print.mjs",
    "verify:devices": "node scripts/verify-two-devices.mjs",
    "verify:phone": "powershell -ExecutionPolicy Bypass -File scripts/verify-on-device.ps1",
    "android:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1 -Sync",
    "android:apk:release": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1 -Sync -Release",
    "apk:publish": "node scripts/publish-apk.mjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^6.1.0",
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/geolocation": "^6.1.0",
    "@capacitor/network": "^6.0.3",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/share": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@fontsource/baloo-2": "^5.1.0",
    "@fontsource/manrope": "^5.1.0",
    "@supabase/supabase-js": "^2.112.2",
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "puppeteer-core": "^25.5.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
